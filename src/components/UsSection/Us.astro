---
import Button from '../Button/Button.astro'
import Logo from '../Logo/Logo.astro';

interface Props{
    id: string;
}
const {id} = Astro.props
---

<div 
id={id}
class="flex bkg-gradient justify-center bkg-section pb-12 md:h-[500px]">
    <div class="grid place-items-center gap-8 text-center w-10/12 md:grid-cols-2 pt-16 md:relative">
        <Logo description='potenciando tu presencia en línea'/>
        <div class="flex flex-col gap-y-8">
            <!-- text-[#030508] -->
             <!-- <b class="opacity-80">Diseño y Desarrollo web</b> -->
            <p class="max-w-3xl text-base text-center js-scroll fade-in-bottom scrolled text-balance md:text-lg md:text-start">
                En RenPi transformamos la presencia de tu marca mediante <b class="opacity-80">Fotografía</b> y <b class="opacity-80">Video</b> de calidad. <br> 
                Nos especializamos en producción audiovisual premium para empresas, deportes y proyectos que buscan elevar su valor percibido y destacar en el mercado. 
            </p>
            <div class="h-auto w-full md:hidden">
                <Button
                url="#contacto"
                value="¡Contáctanos!"
                target='_self'
                />
            </div>
        </div>
        <div class="md:h-auto md:w-full hidden md:block md:absolute md:bottom-0">
            <!-- TODO, crear un stye condicional para el mediaquerie -->
            <Button
            url="#contacto"
            value="¡Contáctanos!"
            target='_self'
            />
        </div>
    </div>
</div>
<style>
    .bkg-section{
        background-color: rgb(44, 53, 69);
    }
    .us-section{
        color: whitesmoke;
    }
</style>